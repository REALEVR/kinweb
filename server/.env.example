# Copy to .env and adjust.

NODE_ENV=development

# ─── Database ────────────────────────────────────────────────────────────────
# Local: any Postgres. Quickest is `docker run -p 5432:5432 -e POSTGRES_PASSWORD=postgres postgres:16-alpine`
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/kinweb"
#
# Hosted trial: Neon free tier (https://neon.tech). Use the POOLED string (host
# contains "-pooler"); run `prisma migrate` against the DIRECT one, which needs
# a session-mode connection.

# Signs auth tokens. Generate a real one: openssl rand -base64 32
JWT_SECRET="dev-only-change-me"

PORT=4000

# Your deployed client URL in production, or CORS blocks every browser call.
CLIENT_ORIGIN="http://localhost:5173"

# How many relationship hops count as "family" for FAMILY_ONLY visibility.
# Unbounded traversal would make an entire connected clan "family" to everyone
# in it, quietly defeating the tier. See server/src/lib/graph.ts.
FAMILY_DEGREES=3

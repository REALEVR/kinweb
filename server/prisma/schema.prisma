// Kinweb — data model
//
// Postgres (Neon free tier). Deliberately NOT a graph database: the brief calls
// for a relational store with application-level traversal, and says to revisit
// that only if traversal actually becomes the bottleneck.
//
// The privacy fields below are load-bearing, not metadata. Every default here is
// the restrictive one, because this product stores data about real people who
// never signed up. See server/src/lib/visibility.ts — the defaults in this file
// only hold if that module is the single gate every read passes through.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  displayName  String
  createdAt    DateTime @default(now())

  claimedPeople   Person[]        @relation("PersonClaimant")
  guardianOf      Person[]        @relation("PersonGuardian")
  addedPeople     Person[]        @relation("PersonAddedBy")
  addedRelations  Relationship[]  @relation("RelationshipAddedBy")
  confirmations   RelationshipConfirmation[]
  claimRequests   ClaimRequest[]
  erasureRequests ErasureRequest[]
}

/// One real person. May exist without ever having consented — that is the whole
/// risk of this product, and why privacyTier defaults to FAMILY_ONLY.
model Person {
  id          String  @id @default(cuid())
  displayName String

  // Approximate by design. Most contributors do not know exact dates for older
  // generations, and a schema that demands precision invites invented precision.
  birthYear          Int?
  birthYearIsExact   Boolean @default(false)
  deathYear          Int?
  deathYearIsExact   Boolean @default(false)

  photoUrl String?
  bio      String?

  /// Freeform on purpose. Some jurisdictions restrict structured health and
  /// cause-of-death data; a text field keeps this out of queryable health-data
  /// territory. Do not "normalise" this into enums or codes later.
  deceasedNotes String?

  /// FAMILY_ONLY | PUBLIC | LOCKED. Never defaults to PUBLIC, for anyone.
  /// LOCKED is the end state of an honoured erasure request.
  privacyTier String @default("FAMILY_ONLY")

  claimedByUserId String?
  claimedBy       User?   @relation("PersonClaimant", fields: [claimedByUserId], references: [id])
  claimedAt       DateTime?

  /// Required before a minor's profile may carry a photo at all.
  guardianUserId String?
  guardian       User?   @relation("PersonGuardian", fields: [guardianUserId], references: [id])

  verified Boolean @default(false)

  addedByUserId String?
  addedBy       User?   @relation("PersonAddedBy", fields: [addedByUserId], references: [id])

  /// Set when an erasure/lockdown request is honoured. A locked node stays in
  /// the graph so relationships do not silently break, but discloses nothing.
  lockedAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  relationshipsAsA Relationship[]   @relation("PersonA")
  relationshipsAsB Relationship[]   @relation("PersonB")
  claimRequests    ClaimRequest[]
  erasureRequests  ErasureRequest[]
  mergeAsA         MergeSuggestion[] @relation("MergeA")
  mergeAsB         MergeSuggestion[] @relation("MergeB")

  @@index([privacyTier])
  @@index([displayName])
}

/// An edge in the web. Stored once, not twice: `child` is read as the inverse of
/// PARENT rather than stored as its own row, so the two can never disagree.
model Relationship {
  id String @id @default(cuid())

  personAId String
  personA   Person @relation("PersonA", fields: [personAId], references: [id], onDelete: Cascade)
  personBId String
  personB   Person @relation("PersonB", fields: [personBId], references: [id], onDelete: Cascade)

  /// PARENT (A is parent of B) | SPOUSE | SIBLING
  type String

  addedByUserId String?
  addedBy       User?   @relation("RelationshipAddedBy", fields: [addedByUserId], references: [id])

  /// True once both claimants agree, or a majority of linked relatives do.
  confirmed Boolean @default(false)

  createdAt DateTime @default(now())

  confirmations RelationshipConfirmation[]

  // One edge per ordered pair per type — blocks duplicate rows for the same fact.
  @@unique([personAId, personBId, type])
  @@index([personAId])
  @@index([personBId])
}

model RelationshipConfirmation {
  id             String   @id @default(cuid())
  relationshipId String
  relationship   Relationship @relation(fields: [relationshipId], references: [id], onDelete: Cascade)
  userId         String
  user           User     @relation(fields: [userId], references: [id])
  createdAt      DateTime @default(now())

  @@unique([relationshipId, userId])
}

/// How an unclaimed profile becomes claimed by the real person or a close relative.
model ClaimRequest {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  requestingUserId String
  requestingUser  User     @relation(fields: [requestingUserId], references: [id])
  evidence        String
  /// PENDING | APPROVED | REJECTED
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@unique([personId, requestingUserId])
  @@index([status])
}

/// A living person must be able to lock or erase their own node even when
/// someone else "owns" it in the UI. Product requirement, not a legal footnote —
/// so it is a first-class table, not a support inbox.
model ErasureRequest {
  id              String   @id @default(cuid())
  personId        String
  person          Person   @relation(fields: [personId], references: [id], onDelete: Cascade)
  requestingUserId String?
  requestingUser  User?    @relation(fields: [requestingUserId], references: [id])
  /// Contact for a requester with no account — a non-consenting subject will
  /// usually not have one, and requiring signup to be forgotten is backwards.
  contactEmail    String?
  /// LOCKDOWN (hide everything, keep edges) | ERASE (remove personal data)
  kind            String   @default("LOCKDOWN")
  reason          String?
  /// PENDING | HONOURED | REJECTED
  status          String   @default("PENDING")
  createdAt       DateTime @default(now())
  resolvedAt      DateTime?

  @@index([status])
}

/// Surfaced, never auto-applied — a wrong merge is worse than a missed one.
model MergeSuggestion {
  id        String @id @default(cuid())
  personAId String
  personA   Person @relation("MergeA", fields: [personAId], references: [id], onDelete: Cascade)
  personBId String
  personB   Person @relation("MergeB", fields: [personBId], references: [id], onDelete: Cascade)

  matchScore      Float
  sharedRelatives Int    @default(0)
  /// SUGGESTED | ACCEPTED | DISMISSED. Only ever moved off SUGGESTED by a human.
  status          String @default("SUGGESTED")
  createdAt       DateTime @default(now())

  @@unique([personAId, personBId])
  @@index([status, matchScore])
}
